# Environnement de test (phpunit). .env.local n'est PAS chargé en test : définir DATABASE_URL
# dans .env.test.local (ignoré par git) ou dans l'environnement. La base utilisée porte le suffixe _test.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Clés JWT dédiées aux tests (générées par : APP_ENV=test bin/console lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test_private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test_public.pem
JWT_PASSPHRASE=kwesto-test-only

MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=sync://
UPLOAD_STORAGE_DIR=%kernel.project_dir%/var/uploads_test
