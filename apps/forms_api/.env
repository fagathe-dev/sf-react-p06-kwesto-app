# Valeurs par défaut NON SECRÈTES de forms_api (fichier versionné).
# Les secrets et réglages locaux vont dans .env.local (ignoré par git) : DATABASE_URL, MAILER_DSN,
# JWT_PASSPHRASE, APP_SECRET de production… Liste complète : specs/specs_tech.prompt.md §8.2.
#
# Ordre de chargement : .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local ; les vraies
# variables d'environnement l'emportent toujours.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> URLs ###
# URL publique de l'API (génération d'URL hors requête HTTP)
DEFAULT_URI=http://localhost:8000
# Site vitrine (forms_front) et back-office (forms_bo) : liens des e-mails, dont /s/{token}
APP_FRONT_URL=http://localhost:8001
APP_BO_URL=http://localhost:5173
###< URLs ###

###> doctrine/doctrine-bundle ###
# MySQL / MariaDB obligatoire (index FULLTEXT). Identifiants réels dans .env.local.
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/kwesto?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# File d'envoi asynchrone des invitations : bin/console messenger:consume async
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# null://null : aucun e-mail n'est réellement envoyé (avertissement dans logs/mailer/).
# Transport réel dans .env.local, ex. smtp://utilisateur:mot-de-passe@serveur:465
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=no-reply@kwesto.localhost
MAILER_FROM_NAME=kwesto
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
# Clés générées par : bin/console lexik:jwt:generate-keypair (ignorées par git)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Phrase secrète des clés : à définir dans .env.local
JWT_PASSPHRASE=
# Durée de validité du jeton, en secondes (8 h)
JWT_TOKEN_TTL=28800
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Origines autorisées : le back-office (forms_bo)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> reverse-proxy ###
# Adresses des reverse-proxys de confiance (IP réelle du participant), ex. 127.0.0.1,REMOTE_ADDR
TRUSTED_PROXIES=
###< reverse-proxy ###

###> uploads ###
# Taille maximale d'un fichier déposé, en Mo, pour toute la plateforme (specs_tech §8.5).
# upload_max_filesize et post_max_size de PHP doivent être supérieurs ou égaux.
UPLOAD_MAX_SIZE_MB=10
# Stockage privé des fichiers des participants (hors public/)
UPLOAD_STORAGE_DIR=%kernel.project_dir%/var/uploads
###< uploads ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
