{% extends 'base.html.twig' %}

{% block javascripts %}<script type="module" src="{{ asset('js/pages/contact.js') }}"></script>{% endblock %}

{% block body %}
<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Contact</p>
        <h1>Parlons de votre projet</h1>
        <p class="lead">Une démonstration, une question sur les tarifs, un besoin spécifique ? Nous répondons sous un jour ouvré.</p>
    </div>
</section>

<section class="section">
    <div class="container split split--form">
        <div>
            {% if sent %}
                <div class="alert alert--success" role="status">
                    <strong>Merci, votre message a bien été envoyé.</strong>
                    Nous vous répondons rapidement à l'adresse indiquée.
                </div>
            {% endif %}

            {{ form_start(form, { attr: { class: 'form', 'data-contact-form': '' } }) }}
                {% for error in form.vars.errors %}
                    <div class="alert alert--danger" role="alert">{{ error.message }}</div>
                {% endfor %}

                {% for field in [form.name, form.email, form.subject, form.message] %}
                    <div class="field{{ field.vars.errors|length ? ' field--invalid' }}">
                        {{ form_label(field, null, { label_attr: { class: 'field__label' } }) }}
                        {{ form_widget(field, { attr: { class: 'field__control', 'aria-describedby': field.vars.id ~ '_error', 'aria-invalid': field.vars.errors|length ? 'true' : 'false' } }) }}
                        <p class="field__error" id="{{ field.vars.id }}_error" data-field-error>
                            {%- for error in field.vars.errors %}{{ error.message }} {% endfor -%}
                        </p>
                    </div>
                {% endfor %}

                {# Pot de miel : masqué aux humains et aux technologies d'assistance #}
                <div class="honeypot" aria-hidden="true">
                    {{ form_label(form.website) }}
                    {{ form_widget(form.website) }}
                </div>

                {{ form_rest(form) }}

                <button class="btn btn--primary btn--lg" type="submit">Envoyer le message</button>
                <p class="form__note">Vos données servent uniquement à répondre à votre demande. <a href="{{ path('app_privacy') }}">Politique de confidentialité</a>.</p>
            {{ form_end(form) }}
        </div>

        <aside class="contact-aside" aria-label="Autres moyens de contact">
            <h2>Déjà client ?</h2>
            <p>Connectez-vous à votre espace pour retrouver vos questionnaires.</p>
            <a class="btn btn--ghost" href="{{ app_url('/login') }}">Se connecter</a>
            <h2>Démonstration</h2>
            <p>En 20 minutes, nous construisons ensemble votre premier questionnaire et lançons une campagne de test.</p>
        </aside>
    </div>
</section>
{% endblock %}
