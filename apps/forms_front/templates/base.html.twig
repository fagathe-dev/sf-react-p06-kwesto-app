{#
  Gabarit maître du site vitrine (specs_tech §5.3).
  Chaque page fournit `seo` (App\Seo\PageCatalog) : titre, meta description, canonical, OpenGraph,
  Twitter Cards et données structurées JSON-LD. Assets compilés par esbuild + sass (public/css, public/js) :
  aucun AssetMapper, aucune fonction importmap().
#}
{#- URL canonique : toujours l'URL publique du site (DEFAULT_URI), quel que soit l'hôte de la requête -#}
{%- set canonical = site.url ~ path(app.request.attributes.get('_route') ?? 'app_home') -%}
{%- set page_title = seo.title -%}
{%- set page_description = seo.description ?? '' -%}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ page_description }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ canonical }}">

    {# OpenGraph #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="kwesto">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:description" content="{{ page_description }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:image" content="{{ absolute_asset('images/og-kwesto.png') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    {# Twitter Cards #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title }}">
    <meta name="twitter:description" content="{{ page_description }}">
    <meta name="twitter:image" content="{{ absolute_asset('images/og-kwesto.png') }}">

    <meta name="theme-color" content="#4338ca">
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/ds-site.css') }}">

    {# Données structurées : SoftwareApplication sur toutes les pages, FAQPage là où une FAQ est affichée #}
    <script type="application/ld+json">
        {{- {
            '@context': 'https://schema.org',
            '@type': 'SoftwareApplication',
            name: 'kwesto',
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Web',
            url: site.url ~ '/',
            description: 'Plateforme de questionnaires et de sondages sur invitation nominative : lien personnel unique, relances automatiques et statistiques consolidées.',
            inLanguage: 'fr-FR',
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', description: 'Offre Découverte gratuite' },
            featureList: ['7 types de questions', 'Lien personnel à usage unique', 'Relances automatiques', 'Statistiques consolidées', 'Exports CSV et ZIP']
        }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw -}}
    </script>
    {% block structured_data %}{% endblock %}

    {% block stylesheets %}{% endblock %}
    <script type="module" src="{{ asset('js/main.js') }}"></script>
    {% block javascripts %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {% include 'partials/_header.html.twig' %}

    <main id="contenu" tabindex="-1">
        {% block body %}{% endblock %}
    </main>

    {% include 'partials/_footer.html.twig' %}
    {% include 'partials/_consent.html.twig' %}
</body>
</html>
