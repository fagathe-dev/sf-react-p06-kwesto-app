{% extends 'base.html.twig' %}

{% set seo = { title: 'Page introuvable | kwesto', description: '' } %}

{% block body %}
<section class="page-hero">
    <div class="container container--narrow">
        <p class="eyebrow">Erreur {{ status_code }}</p>
        <h1>{{ status_code == 404 ? 'Cette page n\'existe pas.' : 'Une erreur est survenue.' }}</h1>
        <p class="lead">Retournez à l'accueil ou découvrez les fonctionnalités de kwesto.</p>
        <p><a class="btn btn--primary" href="{{ path('app_home') }}">Retour à l'accueil</a></p>
    </div>
</section>
{% endblock %}
