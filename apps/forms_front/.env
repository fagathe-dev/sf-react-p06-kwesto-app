# Valeurs par défaut NON SECRÈTES de forms_front (fichier versionné).
# Secrets et réglages locaux dans .env.local (ignoré par git). Liste : specs/specs_tech.prompt.md §8.3.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> URLs ###
# URL publique du site : canonical, OpenGraph, sitemap.xml, compile-scss.js (ds-icons.css)
DEFAULT_URI=http://localhost:8001
# Back-office (forms_bo) : cible des appels à l'action
APP_BO_URL=http://localhost:5173
###< URLs ###

###> doctrine/doctrine-bundle ###
# Base partagée avec forms_api (MySQL / MariaDB). Identifiants réels dans .env.local.
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/kwesto?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=no-reply@kwesto.localhost
MAILER_FROM_NAME=kwesto
# Destinataire des messages du formulaire de contact
CONTACT_RECIPIENT_EMAIL=
###< symfony/mailer ###

###> reverse-proxy ###
TRUSTED_PROXIES=
###< reverse-proxy ###
